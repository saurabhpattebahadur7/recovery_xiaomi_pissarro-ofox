import /init.recovery.microtrust.rc

on post-fs
    start mtk.plpath.utils.link
	
    # Support A/B feature for EMMC and UFS boot region
    symlink /dev/block/sda /dev/block/mmcblk0boot0
    symlink /dev/block/sdb /dev/block/mmcblk0boot1
    symlink /dev/block/mmcblk0boot0 /dev/block/platform/bootdevice/by-name/preloader_a
    symlink /dev/block/mmcblk0boot1 /dev/block/platform/bootdevice/by-name/preloader_b

    # Support A/B feature for combo emmc and ufs OTA update
    symlink /dev/block/platform/bootdevice/by-name/preloader_a /dev/block/platform/bootdevice/by-name/preloader_emmc_a
    symlink /dev/block/platform/bootdevice/by-name/preloader_b /dev/block/platform/bootdevice/by-name/preloader_emmc_b
    symlink /dev/block/platform/bootdevice/by-name/preloader_a /dev/block/platform/bootdevice/by-name/preloader_ufs_a
    symlink /dev/block/platform/bootdevice/by-name/preloader_b /dev/block/platform/bootdevice/by-name/preloader_ufs_b

    # Support A/B feature for combo emmc and ufs OTA update
    symlink /dev/block/platform/bootdevice/by-name/preloader_a /dev/block/by-name/preloader_emmc_a
    symlink /dev/block/platform/bootdevice/by-name/preloader_b /dev/block/by-name/preloader_emmc_b
    symlink /dev/block/platform/bootdevice/by-name/preloader_a /dev/block/by-name/preloader_ufs_a
    symlink /dev/block/platform/bootdevice/by-name/preloader_b /dev/block/by-name/preloader_ufs_b

    exec u:r:update_engine:s0 root root -- /system/bin/mtk_plpath_utils

    # Start Boot HAL
    start boot-hal-1-2

on init
    export PATH /sbin:/system/bin:/vendor/bin:/vendor/bin/hw
    export LD_LIBRARY_PATH /system/lib64:/vendor/lib64:/vendor/lib64/hw

on fs
    install_keyring

service mtk.plpath.utils.link /system/bin/mtk_plpath_utils
    class main
    user root
    group root system
    disabled
    oneshot
    seclabel u:r:recovery:s0

service keystore_auth /system/bin/keystore_auth
    oneshot
    user system
    group root
    disabled
    seclabel u:r:recovery:s0

service keystore /system/bin/keystore /tmp/misc/keystore
    user root
    group root drmrpc readproc log
    disabled
    seclabel u:r:recovery:s0

service gatekeeper-1-0 /system/bin/android.hardware.gatekeeper@1.0-service
    user root
    group root
    disabled
    seclabel u:r:recovery:s0

service keymaster-4-0 /system/bin/android.hardware.keymaster@4.0-service.beanpod
    user root
    group root drmrpc
    disabled
    oneshot
    seclabel u:r:recovery:s0

on property:crypto.ready=1
    start keymaster-4-0

on property:hwservicemanager.ready=true
    start keymaster-4-0
    start gatekeeper-1-0

on property:ro.crypto.state=unsupported
    stop teei_daemon
    stop keymaster-4-0
    stop gatekeeper-1-0

on property:ro.crypto.state=unencrypted
    stop teei_daemon
    stop keymaster-4-0
    stop gatekeeper-1-0

on property:twrp.decrypt.done=true
    stop teei_daemon
    stop keymaster-4-0
    stop gatekeeper-1-0

on boot
    start health-hal-2-1

on init
    # Logd buffer size
    setprop ro.logd.size 2M

    # SoC info
    setprop ro.soc.model MT6877V/TZA
    setprop ro.soc.manufacturer Mediatek

    # Display type
    setprop ro.vendor.display.type oled

    # FPS default
    setprop ro.vendor.display.default_fps 60

    # 5G capability
    setprop ro.vendor.radio.5g 3

    # Radio features
    setprop ro.vendor.radio.features_common 2

    # DisplayFeature HIDL
    setprop sys.displayfeature_hidl true
    setprop sys.displayfeature.entry.enable true
    setprop sys.displayfeature.hbm.enable true

    # DC Backlight
    setprop persist.displayfeature.dc_backlight.enable false

    # VSYNC durations high FPS
    setprop debug.sf.high_fps.late.sf.duration 8300000
    setprop debug.sf.high_fps.late.app.duration 10000000
    setprop debug.sf.high_fps.early.sf.duration 8300000
    setprop debug.sf.high_fps.early.app.duration 10000000
    setprop debug.sf.high_fps.earlyGl.sf.duration 8300000
    setprop debug.sf.high_fps.earlyGl.app.duration 10000000
    setprop debug.sf.high_fps.hwc.min.duration 7500000

    # SAR / Radio
    setprop persist.vendor.radio.dynamic_sar 1
    setprop persist.vendor.radio.features_common 2
    setprop persist.vendor.vonr_setting_support 1

    # WiFi
    setprop ro.vendor.net.enable_passpoint_r1 1
    setprop persist.vendor.wifienhancelog 1

    # VoNR / VCB
    setprop persist.vendor.vcb.ability true
    setprop persist.vendor.vcb.enable false

    # Modem dump
    setprop persist.vendor.mdlog.need_dump 1
    setprop persist.sys.mdlog_dumpback 2

    # AOD / GIR / CABC / Color
    setprop ro.vendor.aod_layer.check true
    setprop ro.vendor.display.gir.support true
    setprop ro.vendor.cabc.enable true
    setprop ro.vendor.colorpick_adjust true
    setprop ro.vendor.all_modes.colorpick_adjust true

    # Misc display
    setprop ro.vendor.xiaomi.bl.poll true
    setprop ro.vendor.gcp.enable true
    setprop ro.vendor.fps.switch.default true
    setprop ro.vendor.smart_dfps.enable true
    setprop ro.vendor.standard.video.enable true
    setprop ro.whitepoint_calibration_enable false
    setprop ro.displayfeature.histogram.enable false
